datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  firebaseId   String?  @unique
  name         String
  email        String   @unique
  passwordHash String?
  phone        String?
  role         String   @default("HARVESTER")
  beekeeperId  String?  @unique
  bsid         String?  @unique
  bspPass      String?
  organizationName String?
  facilityLocation String?
  licenseNumber    String?
  designation      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hives                 Hive[]
  harvests              Harvest[]
  processingRecords     ProcessingRecord[]
  labReports            LabReport[]
  packagingRecords      PackagingRecord[]
  provenanceEvents      ProvenanceEvent[]
  harvesterVerification HarvesterVerification?

  sentWorkflowRequests     WorkflowRequest[] @relation("SentWorkflowRequests")
  receivedWorkflowRequests WorkflowRequest[] @relation("ReceivedWorkflowRequests")
  requestHistory           RequestHistory[]
}

model Hive {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String
  hiveCode                 String   @unique
  apiaryLocation           String
  hiveType                 String   @default("Langstroth")
  dateAdded                DateTime @default(now())
  queenStatus              String   @default("Mated")
  totalFrames              Int      @default(10)
  broodFrames              Int      @default(0)
  colonyStrength           String   @default("Strong")
  queenAgeMonths           Int      @default(0)
  beeBreed                 String   @default("Italian")
  expectedProductionKg     Float    @default(0.0)
  previousYearProductionKg Float    @default(0.0)
  currentYearProductionKg  Float    @default(0.0)
  honeyType                String   @default("Wildflower")
  lastInspectionDate       DateTime @default(now())
  miteStatus               String   @default("None")
  diseaseStatus            String   @default("None")
  feedingRequired          Boolean  @default(false)
  queenCondition           String   @default("Good")
  overallHealth            String   @default("Healthy")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  harvests Harvest[]

  @@index([userId])
}

model Harvest {
  id          String   @id @default(uuid())
  harvesterId String
  hiveId      String?
  quantity    Float
  unit        String   @default("kg")
  location    String?
  status      String   @default("HARVESTED")
  notes       String?
  createdAt   DateTime @default(now())

  harvester User    @relation(fields: [harvesterId], references: [id])
  hive      Hive?   @relation(fields: [hiveId], references: [id])
  batches   Batch[]
}

model Batch {
  id           String   @id @unique
  harvestId    String
  status       String   @default("HARVESTED")
  currentStage String   @default("HARVEST") // HARVEST, COLLECTION, LAB, PACKAGING, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  harvest Harvest @relation(fields: [harvestId], references: [id])

  chainRequests     ChainRequest[]
  workflowRequests  WorkflowRequest[]
  requestHistory    RequestHistory[]
  processingRecords ProcessingRecord[]
  labReports        LabReport[]
  packagingRecords  PackagingRecord[]
  provenanceEvents  ProvenanceEvent[]
  finalQr          String?   // Base64 PNG/SVG of final QR
  verificationUrl  String?   // Public verification URL
  finalizedAt      DateTime? // Timestamp when final QR was generated
}

model ChainRequest {
  id          String   @id @default(uuid())
  batchId     String
  processorId String?
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
}

model WorkflowRequest {
  id                String    @id @default(uuid())
  requestId         String    @unique // REQ-COL-2026-XXXX, REQ-LAB-2026-XXXX, REQ-PKG-2026-XXXX
  batchId           String
  fromUserId        String
  toUserId          String?
  fromRole          String    // HARVESTER, COLLECTOR_PROCESSOR, LAB, PACKAGING
  toRole            String    // COLLECTOR_PROCESSOR, LAB, PACKAGING
  requestType       String    // HARVEST_TO_COLLECTION, COLLECTION_TO_LAB, LAB_TO_PACKAGING
  status            String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, IN_PROGRESS, VERIFIED, COMPLETED, CANCELLED
  previousRequestId String?
  quantity          Float?
  unit              String    @default("kg")
  notes             String?
  metadata          String?   // JSON string for additional context
  acceptedAt        DateTime?
  completedAt       DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id])
  fromUser         User              @relation("SentWorkflowRequests", fields: [fromUserId], references: [id])
  toUser           User?             @relation("ReceivedWorkflowRequests", fields: [toUserId], references: [id])
  previousRequest  WorkflowRequest?  @relation("RequestChain", fields: [previousRequestId], references: [id])
  nextRequests     WorkflowRequest[] @relation("RequestChain")
  history          RequestHistory[]
  processingRecord ProcessingRecord?
  labReport        LabReport?
  packagingRecord  PackagingRecord?
  provenanceEvents ProvenanceEvent[]

  @@index([batchId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toRole])
  @@index([status])
}

model RequestHistory {
  id         String   @id @default(uuid())
  requestId  String
  batchId    String
  action     String   // CREATED, ACCEPTED, REJECTED, PROCESSED, TESTED, VERIFIED, PACKAGED, COMPLETED, CANCELLED
  fromStatus String?
  toStatus   String
  actorId    String
  actorRole  String
  notes      String?
  txHash     String?
  dataHash   String?
  createdAt  DateTime @default(now())

  request WorkflowRequest @relation(fields: [requestId], references: [id])
  batch   Batch           @relation(fields: [batchId], references: [id])
  actor   User            @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([batchId])
  @@index([actorId])
}

model ProcessingRecord {
  id                String   @id @default(uuid())
  batchId           String
  processorId       String
  requestId         String?  @unique
  quantityReceived  Float
  quantityAfter     Float
  method            String   @default("Standard Cold Extraction")
  moistureAtReceipt Float?
  notes             String?
  createdAt         DateTime @default(now())

  batch     Batch            @relation(fields: [batchId], references: [id])
  processor User             @relation(fields: [processorId], references: [id])
  request   WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model LabReport {
  id                String   @id @default(uuid())
  batchId           String
  labId             String
  requestId         String?  @unique
  testResults       String
  qualityScore      Float?
  moistureContent   Float?
  purityGrade       String?
  contaminantsFound String?  @default("None")
  status            String   @default("APPROVED") // APPROVED, REJECTED
  notes             String?
  createdAt         DateTime @default(now())

  batch   Batch            @relation(fields: [batchId], references: [id])
  lab     User             @relation(fields: [labId], references: [id])
  request WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model PackagingRecord {
  id               String   @id @default(uuid())
  batchId          String
  packagerId       String
  requestId        String?  @unique
  finalQuantity    Float
  numberOfPackages Int
  packageSize      String?  @default("500g Glass Jar")
  notes            String?
  qrCodeUrl        String?
  createdAt        DateTime @default(now())

  batch    Batch            @relation(fields: [batchId], references: [id])
  packager User             @relation(fields: [packagerId], references: [id])
  request  WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model ProvenanceEvent {
  id                String   @id @default(uuid())
  batchId           String
  requestId         String?
  eventType         String
  actorId           String
  dataHash          String
  previousEventHash String?
  txHash            String?
  blockNumber       Int?
  network           String?
  contractAddress   String?
  status            String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  timestamp         DateTime @default(now())

  batch   Batch            @relation(fields: [batchId], references: [id])
  actor   User             @relation(fields: [actorId], references: [id])
  request WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model HarvesterVerification {
  id          String @id @default(uuid())
  harvesterId String @unique

  // 1. Government ID
  governmentIdType        String? // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE
  governmentIdReference   String? // Masked reference e.g. DOC-NAT-***9481
  governmentIdDocHash     String? // Tamper-evident checksum
  governmentIdVerified    String    @default("Not Started") // Not Started, Pending, Verified, Rejected
  governmentIdSubmittedAt DateTime?

  // 2. Mobile Number + OTP
  mobileNumber     String?
  mobileVerified   String    @default("Not Started") // Not Started, Pending, Verified
  mobileVerifiedAt DateTime?

  // 3. Beekeeper Registration ID
  registrationId          String?
  registrationType        String? // STATE_REGISTRY, COOPERATIVE, APICULTURE_BOARD
  registrationVerified    String    @default("Not Started") // Not Started, Pending, Verified, Rejected
  registrationSubmittedAt DateTime?

  // 4. Apiary Location
  apiaryName          String?
  apiaryLocation      String? // Public Generalized Region
  apiaryCoordinates   String? // Private/Secure GPS coordinates off-chain
  locationVerified    String    @default("Not Started") // Not Started, Pending, Verified
  locationSubmittedAt DateTime?

  // 5. Blockchain / Final Verification
  verificationStatus String    @default("Not Started") // Not Started, In Progress, Pending Review, Verified, Rejected, Blockchain Pending, Blockchain Failed
  verificationId     String?   @unique // HV-2026-XXXX
  verificationHash   String? // SHA-256 canonical hash
  blockchainNetwork  String? // Local Hardhat, Ethereum Sepolia, Polygon Amoy
  transactionHash    String?
  blockNumber        Int?

  reviewNotes String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  harvester User @relation(fields: [harvesterId], references: [id])
}

model MobileOtp {
  id            String   @id @default(uuid())
  mobile        String
  otpHash       String
  expiresAt     DateTime
  attempts      Int      @default(0)
  cooldownUntil DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}
