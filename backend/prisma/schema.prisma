datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  firebaseId   String?
  name         String
  email        String
  passwordHash String?
  phone        String?
  avatarUrl    String?
  googlePhotoUrl String?
  authProvider String?  @default("local")
  role         String   @default("HARVESTER")
  beekeeperId  String?  @unique
  bsid         String?  @unique
  bspPass      String?
  organizationName String?
  facilityLocation String?
  licenseNumber    String?
  designation      String?
  resetToken       String?
  resetExpiry      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hives                 Hive[]
  harvests              Harvest[]
  processingRecords     ProcessingRecord[]
  labReports            LabReport[]
  packagingRecords      PackagingRecord[]
  provenanceEvents      ProvenanceEvent[]
  harvesterVerification HarvesterVerification?
  collectorVerification CollectorVerification?
  labVerification       LabVerification?
  packagingVerification PackagingVerification?

  sentWorkflowRequests     WorkflowRequest[] @relation("SentWorkflowRequests")
  receivedWorkflowRequests WorkflowRequest[] @relation("ReceivedWorkflowRequests")
  requestHistory           RequestHistory[]

  @@unique([email, role])
  @@index([email])
  @@index([role])
}

model Hive {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String
  hiveCode                 String   @unique
  apiaryLocation           String
  hiveType                 String   @default("Langstroth")
  dateAdded                DateTime @default(now())
  queenStatus              String   @default("Mated")
  totalFrames              Int      @default(10)
  broodFrames              Int      @default(0)
  colonyStrength           String   @default("Strong")
  queenAgeMonths           Int      @default(0)
  beeBreed                 String   @default("Italian")
  expectedProductionKg     Float    @default(0.0)
  previousYearProductionKg Float    @default(0.0)
  currentYearProductionKg  Float    @default(0.0)
  honeyType                String   @default("Wildflower")
  lastInspectionDate       DateTime @default(now())
  miteStatus               String   @default("None")
  diseaseStatus            String   @default("None")
  feedingRequired          Boolean  @default(false)
  queenCondition           String   @default("Good")
  overallHealth            String   @default("Healthy")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  harvests Harvest[]
  telemetry HiveTelemetry[]
  alerts    HiveAlert[]

  @@index([userId])
}

model Harvest {
  id          String   @id @default(uuid())
  harvesterId String
  hiveId      String?
  quantity    Float
  unit        String   @default("kg")
  location    String?
  status      String   @default("HARVESTED")
  notes       String?
  createdAt   DateTime @default(now())

  harvester User    @relation(fields: [harvesterId], references: [id])
  hive      Hive?   @relation(fields: [hiveId], references: [id])
  batches   Batch[]
}

model Batch {
  id           String   @id @unique
  harvestId    String
  status       String   @default("HARVESTED")
  currentStage String   @default("HARVEST") // HARVEST, COLLECTION, LAB, PACKAGING, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  harvest Harvest @relation(fields: [harvestId], references: [id])

  chainRequests     ChainRequest[]
  workflowRequests  WorkflowRequest[]
  requestHistory    RequestHistory[]
  processingRecords ProcessingRecord[]
  labReports        LabReport[]
  packagingRecords  PackagingRecord[]
  provenanceEvents  ProvenanceEvent[]
}

model ChainRequest {
  id          String   @id @default(uuid())
  batchId     String
  processorId String?
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
}

model WorkflowRequest {
  id                String    @id @default(uuid())
  requestId         String    @unique // REQ-COL-2026-XXXX, REQ-LAB-2026-XXXX, REQ-PKG-2026-XXXX
  batchId           String
  fromUserId        String
  toUserId          String?
  fromRole          String    // HARVESTER, COLLECTOR_PROCESSOR, LAB, PACKAGING
  toRole            String    // COLLECTOR_PROCESSOR, LAB, PACKAGING
  requestType       String    // HARVEST_TO_COLLECTION, COLLECTION_TO_LAB, LAB_TO_PACKAGING
  status            String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, IN_PROGRESS, VERIFIED, COMPLETED, CANCELLED
  previousRequestId String?
  quantity          Float?
  unit              String    @default("kg")
  notes             String?
  metadata          String?   // JSON string for additional context
  acceptedAt        DateTime?
  completedAt       DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id])
  fromUser         User              @relation("SentWorkflowRequests", fields: [fromUserId], references: [id])
  toUser           User?             @relation("ReceivedWorkflowRequests", fields: [toUserId], references: [id])
  previousRequest  WorkflowRequest?  @relation("RequestChain", fields: [previousRequestId], references: [id])
  nextRequests     WorkflowRequest[] @relation("RequestChain")
  history          RequestHistory[]
  processingRecord ProcessingRecord?
  labReport        LabReport?
  packagingRecord  PackagingRecord?
  provenanceEvents ProvenanceEvent[]

  @@index([batchId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toRole])
  @@index([status])
}

model RequestHistory {
  id         String   @id @default(uuid())
  requestId  String
  batchId    String
  action     String   // CREATED, ACCEPTED, REJECTED, PROCESSED, TESTED, VERIFIED, PACKAGED, COMPLETED, CANCELLED
  fromStatus String?
  toStatus   String
  actorId    String
  actorRole  String
  notes      String?
  txHash     String?
  dataHash   String?
  createdAt  DateTime @default(now())

  request WorkflowRequest @relation(fields: [requestId], references: [id])
  batch   Batch           @relation(fields: [batchId], references: [id])
  actor   User            @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([batchId])
  @@index([actorId])
}

model ProcessingRecord {
  id                String   @id @default(uuid())
  batchId           String
  processorId       String
  requestId         String?  @unique
  quantityReceived  Float
  quantityAfter     Float
  method            String   @default("Standard Cold Extraction")
  moistureAtReceipt Float?
  notes             String?
  createdAt         DateTime @default(now())

  batch     Batch            @relation(fields: [batchId], references: [id])
  processor User             @relation(fields: [processorId], references: [id])
  request   WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model LabReport {
  id                  String    @id @default(uuid())
  reportId            String?   @unique // LAB-RPT-2026-XXXX
  qrTraceabilityId    String?
  batchId             String
  labId               String
  requestId           String?   @unique
  testResults         String
  qualityScore        Float?
  moistureContent     Float?
  purityGrade         String?
  contaminantsFound   String?   @default("None")
  status              String    @default("APPROVED") // APPROVED, REJECTED
  overallResult       String    @default("PASS")     // PASS, FAIL

  // Specific parameters with thresholds and status
  moistureValue       Float?
  moistureLimit       String?   @default("<= 20.0%")
  moistureStatus      String?   @default("PASS") // PASS, FAIL

  hmfValue            Float?
  hmfLimit            String?   @default("<= 40.0 mg/kg")
  hmfStatus           String?   @default("PASS")

  diastaseValue       Float?
  diastaseLimit       String?   @default(">= 8.0 Schade Units")
  diastaseStatus      String?   @default("PASS")

  purityValue         Float?
  purityLimit         String?   @default(">= 0.95 F/G Ratio")
  purityStatus        String?   @default("PASS")

  residuesValue       String?   @default("None Detected")
  residuesLimit       String?   @default("0.0 ppm")
  residuesStatus      String?   @default("PASS")

  pollenValue         String?   @default("Authentic Floral Matrix")
  pollenLimit         String?   @default("Botanical Authentic")
  pollenStatus        String?   @default("PASS")

  labTesterName       String?
  labName             String?
  testDate            DateTime? @default(now())
  sampleCode          String?
  remarks             String?
  testerSignatureHash String?
  notes               String?
  createdAt           DateTime  @default(now())

  batch   Batch            @relation(fields: [batchId], references: [id])
  lab     User             @relation(fields: [labId], references: [id])
  request WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model PackagingRecord {
  id               String   @id @default(uuid())
  batchId          String
  packagerId       String
  requestId        String?  @unique
  finalQuantity    Float
  numberOfPackages Int
  packageSize      String?  @default("500g Glass Jar")
  notes            String?
  qrCodeUrl        String?
  createdAt        DateTime @default(now())

  batch    Batch            @relation(fields: [batchId], references: [id])
  packager User             @relation(fields: [packagerId], references: [id])
  request  WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model ProvenanceEvent {
  id                String   @id @default(uuid())
  batchId           String
  requestId         String?
  eventType         String
  actorId           String
  dataHash          String
  previousEventHash String?
  txHash            String?
  blockNumber       Int?
  network           String?
  contractAddress   String?
  status            String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  timestamp         DateTime @default(now())

  batch   Batch            @relation(fields: [batchId], references: [id])
  actor   User             @relation(fields: [actorId], references: [id])
  request WorkflowRequest? @relation(fields: [requestId], references: [id])
}

model HarvesterVerification {
  id          String @id @default(uuid())
  harvesterId String @unique

  // 1. Government ID
  governmentIdType        String? // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE
  governmentIdReference   String? // Masked reference e.g. DOC-NAT-***9481
  governmentIdDocHash     String? // Tamper-evident checksum
  governmentIdVerified    String    @default("Not Started") // Not Started, Pending, Verified, Rejected
  governmentIdSubmittedAt DateTime?

  // 2. Mobile Number + OTP
  mobileNumber     String?
  mobileVerified   String    @default("Not Started") // Not Started, Pending, Verified
  mobileVerifiedAt DateTime?

  // 3. Beekeeper Registration ID
  registrationId          String?
  registrationType        String? // STATE_REGISTRY, COOPERATIVE, APICULTURE_BOARD
  registrationVerified    String    @default("Not Started") // Not Started, Pending, Verified, Rejected
  registrationSubmittedAt DateTime?

  // 3.5 FSSAI License
  fssaiLicense            String?
  fssaiLicenseVerified    String    @default("Not Started") // Not Started, Pending, Verified, Rejected
  fssaiLicenseSubmittedAt DateTime?

  // 4. Apiary Location
  apiaryName          String?
  apiaryLocation      String? // Public Generalized Region
  apiaryCoordinates   String? // Private/Secure GPS coordinates off-chain
  locationVerified    String    @default("Not Started") // Not Started, Pending, Verified
  locationSubmittedAt DateTime?

  // 5. Blockchain / Final Verification
  verificationStatus String    @default("Not Started") // Not Started, In Progress, Pending Review, Verified, Rejected, Blockchain Pending, Blockchain Failed
  verificationId     String?   @unique // HV-2026-XXXX
  verificationHash   String? // SHA-256 canonical hash
  blockchainNetwork  String? // Local Hardhat, Ethereum Sepolia, Polygon Amoy
  transactionHash    String?
  blockNumber        Int?

  reviewNotes String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  harvester User @relation(fields: [harvesterId], references: [id])
}

model MobileOtp {
  id            String   @id @default(uuid())
  mobile        String
  otpHash       String
  expiresAt     DateTime
  attempts      Int      @default(0)
  cooldownUntil DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model CollectorVerification {
  id                    String    @id @default(uuid())
  collectorId           String    @unique
  collector             User      @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  // 1. Identity Verification (Full Name & Mobile OTP)
  fullName              String?
  mobileNumber          String?
  mobileVerified        String    @default("Not Started") // Not Started, Pending, Verified
  mobileVerifiedAt      DateTime?

  // 2. Business Verification (Center Name & Center Address)
  organizationName      String?
  facilityLocation      String?
  businessDetails       String?
  businessVerified      String    @default("Not Started") // Not Started, Pending, Verified
  businessVerifiedAt    DateTime?

  // 3. License & KYC (Government ID & Verification via Real KYC Provider)
  governmentIdType      String?   // AADHAAR, PAN, PASSPORT, DRIVERS_LICENSE, FSSAI_LICENSE
  governmentIdReference String?   // Masked reference
  governmentIdDocHash   String?
  licenseNumber         String?
  kycProvider           String?   // DIGIO, SIGNZY, HYPERVERGE, SANDBOX
  kycStatus             String    @default("Not Started") // Not Started, Pending, Verified, Failed
  kycVerifiedAt         DateTime?

  // Overall Profile Verification Status (3/3)
  verificationStatus    String    @default("Not Started") // Not Started, In Progress, Verified
  verifiedAt            DateTime?
  reviewNotes           String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model LabVerification {
  id                       String    @id @default(uuid())
  labId                    String    @unique
  lab                      User      @relation(fields: [labId], references: [id], onDelete: Cascade)

  // 1. Identity & Contact (Full Name & Mobile OTP)
  fullName                 String?
  mobileNumber             String?
  mobileVerified           String    @default("Not Started") // Not Started, Pending, Verified
  mobileVerifiedAt         DateTime?

  // 2. Laboratory Details (Name, Address, Registration)
  labName                  String?
  labAddress               String?
  labRegistrationNumber    String?   // NABL, FSSAI, ISO/IEC 17025
  accreditation            String?   // Accreditation board / scope
  labDetailsVerified       String    @default("Not Started") // Not Started, Pending, Verified
  labDetailsVerifiedAt     DateTime?

  // 3. KYC & Certification (Government ID + Real KYC + Qualification)
  governmentIdType         String?   // AADHAAR, PAN, PASSPORT, DRIVERS_LICENSE
  governmentIdReference    String?   // Masked reference
  governmentIdDocHash      String?
  qualification            String?   // e.g. Lead Food Safety Chemist / M.Sc Analytical Chemistry
  authorizedTestingDetails String?   // Scope: Moisture, HMF, Diastase, Pollen, Antibiotic residues
  kycProvider              String?   // DIGIO, SIGNZY, HYPERVERGE, SANDBOX
  kycStatus                String    @default("Not Started") // Not Started, Pending, Verified, Failed
  kycVerifiedAt            DateTime?

  // Overall Profile Verification Status (3/3)
  verificationStatus       String    @default("Not Started") // Not Started, In Progress, Verified
  verifiedAt               DateTime?
  reviewNotes              String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model PackagingVerification {
  id                         String    @id @default(uuid())
  packagerId                 String    @unique
  packager                   User      @relation(fields: [packagerId], references: [id], onDelete: Cascade)

  // 1. Identity & Contact (Full Name & Mobile OTP)
  fullName                   String?
  mobileNumber               String?
  mobileVerified             String    @default("Not Started") // Not Started, Pending, Verified
  mobileVerifiedAt           DateTime?

  // 2. Packaging Facility Details (Organization, Address, License)
  organizationName           String?
  facilityLocation           String?
  packagingLicenseNumber     String?   // FSSAI Packaging License, Legal Metrology, AGMARK
  facilityDetailsVerified    String    @default("Not Started") // Not Started, Pending, Verified
  facilityDetailsVerifiedAt  DateTime?

  // 3. License & KYC (Government ID + Real KYC + Operational Specs)
  governmentIdType           String?   // AADHAAR, PAN, GSTIN, FSSAI_LICENSE
  governmentIdReference      String?
  governmentIdDocHash        String?
  authorizedPackagingDetails String?   // Packaging capacity, glass jars / tamper-evident seals
  kycProvider                String?
  kycStatus                  String    @default("Not Started") // Not Started, Pending, Verified, Failed
  kycVerifiedAt              DateTime?

  // Overall Profile Verification Status (3/3)
  verificationStatus         String    @default("Not Started") // Not Started, In Progress, Verified
  verifiedAt                 DateTime?
  reviewNotes                String?

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model HiveTelemetry {
  id               String   @id @default(uuid())
  hiveId           String
  hiveCode         String?
  temperature      Float
  humidity         Float
  weightKg         Float
  beeActivity      Float    // percentage or index (0-100)
  soundFrequencyHz Float?
  batteryLevel     Float?   @default(100.0)
  signalStrength   Float?   @default(-65.0)
  recordedAt       DateTime @default(now())

  hive Hive @relation(fields: [hiveId], references: [id], onDelete: Cascade)

  @@index([hiveId])
  @@index([recordedAt])
}

model HiveAlert {
  id             String    @id @default(uuid())
  hiveId         String
  hiveCode       String
  parameter      String    // Temperature, Humidity, Hive weight, Bee activity, Sound Frequency
  previousValue  String
  currentValue   String
  changeValue    String    // e.g. +7.4°C
  unit           String    // °C, %, kg, /min, Hz
  severity       String    @default("CRITICAL") // CRITICAL, WARNING
  message        String
  status         String    @default("ACTIVE")   // ACTIVE, ACKNOWLEDGED
  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())

  hive Hive @relation(fields: [hiveId], references: [id], onDelete: Cascade)

  @@index([hiveId])
  @@index([status])
  @@index([detectedAt])
}



