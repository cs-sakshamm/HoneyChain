# ==============================================================================
# HoneyChain Backend Environment Configuration (.env.example)
# Copy to backend/.env and replace dummy values with your secrets.
# DO NOT commit real secrets or credentials to source control.
# Variable names here match EXACTLY what the code reads (backend/main.py,
# backend/database.py, backend/services/*, qr_service.py).
# ==============================================================================

# ── Server ──
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database (Supabase PostgreSQL — authoritative) ──
# Construct the URL from your Supabase project credentials. The password is
# stored ONLY here (never commit the real .env) and must be URL-encoded if it
# contains special characters such as @ : / ? # % & (e.g. '@' -> %40).
#
#   Host    : db.<your-project-ref>.supabase.co
#   Port    : 5432
#   Database: postgres
#   User    : postgres
#
# DATABASE_URL=postgresql://postgres:<URL-ENCODED-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# NOTE ON NETWORKS: the direct db.<ref>.supabase.co host is IPv6-only on newer
# projects (unless the IPv4 add-on is enabled). On IPv4-only networks (or when
# the project appears paused and the direct host stops resolving), use the
# Supavisor session pooler instead — same database, IPv4 reachable:
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# If connections fail with "tenant ... not found" or the host no longer
# resolves, check the project is not PAUSED in the Supabase dashboard.
#
# Optional discrete variables (some tooling reads these instead of the URL):
POSTGRES_HOST=db.<project-ref>.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
#
# A localhost PostgreSQL URL is rejected at startup: HoneyChain runs on
# Supabase, and pointing DATABASE_URL at a local server previously caused
# "password authentication failed for user postgres".
#
# Set DEV_OFFLINE_SQLITE=true ONLY for offline unit tests without Postgres.
# A failing PostgreSQL connection never falls back to SQLite silently.
DEV_OFFLINE_SQLITE=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Authentication (read by backend/main.py) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google Sign-In (server-side ID-token verification) ──
# Firebase Auth ID tokens are verified in Python by project ID/audience.
# The web API key below is public Firebase client config; Python token
# verification does not use it unless you add Firebase Auth REST calls.
FIREBASE_PROJECT_ID=honeychain-40065
FIREBASE_WEB_API_KEY=AIzaSyDJFOj7F7I7-NIqclH4JLBhDZzvqb9_uIU
FIREBASE_AUTH_DOMAIN=honeychain-40065.firebaseapp.com
GOOGLE_CLIENT_ID=

# ── MQTT Broker (read by backend/services/mqtt_consumer.py) ──
# Inside Docker use host "mosquitto". Local native runs: keep localhost.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=honeychain_backend
MQTT_PASSWORD=change_this_broker_password
MQTT_INPUT_TOPIC=honeychain/hive/telemetry
MQTT_OUTPUT_TOPIC=honeychain/hive/processed

# ── Blockchain (read by backend/services/blockchain_service.py) ──
# Local Hardhat node: http://host.docker.internal:8545 (from container) or http://127.0.0.1:8545 (native)
# Polygon Amoy testnet: https://rpc-amoy.polygon.technology
# Local EVM development: start `npm run node` in blockchain/, then use one
# of the printed development keys only in your untracked backend/.env file.
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK_NAME=Hardhat Localhost (Chain ID: 31337)

# ── QR / Public verification base URL (read by backend/services/qr_service.py) ──
# Public hostname your consumers will open. Leave as-is for local demo.
PUBLIC_APP_URL=http://127.0.0.1:8000
