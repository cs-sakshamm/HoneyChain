# HoneyChain Backend Environment Variables

PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Aadhaar / KYC Provider Configuration
# Supported options: 'sandbox' | 'signzy' | 'hyperverge' | 'digio'
AADHAAR_PROVIDER=sandbox

# Environment: 'sandbox' | 'production'
AADHAAR_ENVIRONMENT=sandbox

# API Credentials for legitimate UIDAI-authorized KYC Providers
# (Keep empty or unset when using 'sandbox' provider)
AADHAAR_API_KEY=""
AADHAAR_API_SECRET=""
AADHAAR_CLIENT_ID=""
AADHAAR_BASE_URL=""

# Dedicated provider key aliases (optional overrides)
SIGNZY_API_KEY=""
SIGNZY_API_SECRET=""
HYPERVERGE_APP_ID=""
HYPERVERGE_APP_KEY=""
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""

# Blockchain RPC Node
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
