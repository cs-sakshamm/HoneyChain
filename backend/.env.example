# HoneyChain Backend Environment Variables

PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Aadhaar / KYC Provider Configuration
# Supported options: 'sandbox' | 'signzy' | 'hyperverge' | 'digio'
AADHAAR_PROVIDER=sandbox

# Environment: 'sandbox' | 'production'
AADHAAR_ENVIRONMENT=sandbox

# API Credentials for legitimate UIDAI-authorized KYC Providers
# (Keep empty or unset when using 'sandbox' provider)
AADHAAR_API_KEY=""
AADHAAR_API_SECRET=""
AADHAAR_CLIENT_ID=""
AADHAAR_BASE_URL=""

# Dedicated provider key aliases (optional overrides)
SIGNZY_API_KEY=""
SIGNZY_API_SECRET=""
HYPERVERGE_APP_ID=""
HYPERVERGE_APP_KEY=""
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""

# SMS OTP Provider Configuration (2Factor / MSG91 / Sandbox)
# Supported options: 'sandbox' | '2factor' | 'msg91'
OTP_PROVIDER=sandbox

# Environment: 'sandbox' | 'production'
OTP_ENVIRONMENT=sandbox

# 2Factor SMS OTP Gateway (Primary Provider - India DLT Compliant)
TWOFACTOR_API_KEY=""
TWOFACTOR_SENDER_ID="HNYCHN"
TWOFACTOR_TEMPLATE_NAME=""

# MSG91 SendOTP Gateway (Alternative Provider)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Generic aliases
OTP_API_KEY=""
OTP_SENDER_ID=""
OTP_TEMPLATE_NAME=""

# Blockchain RPC Node
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
