<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The backend URL for Android emulator is the host-loopback
  alias http://10.0.2.2:8000 (see AppConstants.backendBaseUrl), which is plain
  HTTP. Android 9+ (targetSdk >= 28) blocks cleartext by default, which made
  every API call fail with a connection error even when the backend was up.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true"/>
</manifest>
