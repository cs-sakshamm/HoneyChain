# HoneyChain blockchain deployment configuration (template).
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore: `.env`, `.env.*`, `!.env.example`)
# and is never committed. Never put a real private key in this template
# or in any tracked file.

# ── Local Hardhat development ─────────────────────────────────────────────
# Start a local chain with: npm run node
# Then deploy with an UNCOMMENTED local key from `npx hardhat node` output.
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CHAIN_ID=31337
# BLOCKCHAIN_PRIVATE_KEY=0x<key printed by the local node, dev use only>

# ── Polygon Amoy testnet ──────────────────────────────────────────────────
# Requires a dedicated wallet funded with test MATIC from a faucet.
# BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_CHAIN_ID=80002
# BLOCKCHAIN_PRIVATE_KEY=0x<your own Amoy deployer private key>

# ── Polygon mainnet ───────────────────────────────────────────────────────
# BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
# BLOCKCHAIN_CHAIN_ID=137
# BLOCKCHAIN_PRIVATE_KEY=0x<production deployer key - handle with care>
